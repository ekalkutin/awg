# Copy to .env next to docker-compose.yml. No secrets here: those live in data/.

# Image you pushed to Docker Hub
AWG_IMAGE=ekalkutin/tunnel:latest

# Public IP or hostname clients connect to. With a hostname, moving to another VPS
# only needs a DNS change, client configs stay valid.
AWG_ENDPOINT=tunnel.kalkutin.dev
# UDP port. Pick a random one (20000-60000), avoid 51820 (plain WireGuard).
AWG_PORT=47123

# Optional: client config defaults (apply to "peer add" and "peer show")
# AWG_CLIENT_DNS=1.1.1.1, 1.0.0.1
# AWG_CLIENT_MTU=1280
# AWG_CLIENT_ALLOWED_IPS=0.0.0.0/0, ::/0
# AWG_CLIENT_PERSISTENT_KEEPALIVE=25-35

# Optional: tunnel subnet, used only when data/ is created (first start)
# AWG_ADDRESS=10.13.37.1/24
